# Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Andhera Raja API"
API_V1_PREFIX=/api/v1

# Supabase Auth & JWT
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Database (Supabase PostgreSQL pooler on port 6543 or direct port 5432)
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# CORS (comma-separated origins)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Provably Fair Game Encryption Key (32-byte base64 Fernet key)
ENCRYPTION_KEY=
